{
  "rules": {
    ".read": false,
    ".write": false,
    "likes": {
      "global": {
        ".read": true,
        ".write": true,
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000000"
      },
      "users": {
        "$uid": {
          ".read": true,
          ".write": true,
          ".validate": "newData.isBoolean() || !newData.exists()"
        }
      }
    }
  }
}
